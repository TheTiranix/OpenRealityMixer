<UserControl x:Class="OpenRealityMixer.UI.SliderRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Margin="0,2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="68" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Label, ElementName=Root}" VerticalAlignment="Center" />
        <Slider Grid.Column="1" Margin="4,0" VerticalAlignment="Center"
                Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                Value="{Binding Value, ElementName=Root, Mode=TwoWay}"
                SmallChange="{Binding Step, ElementName=Root}"
                LargeChange="{Binding Step, ElementName=Root}" />
        <TextBox Grid.Column="2" VerticalContentAlignment="Center" TextAlignment="Right"
                 Text="{Binding Value, ElementName=Root, Mode=TwoWay, StringFormat={}{0:0.###}, UpdateSourceTrigger=LostFocus}" />
    </Grid>
</UserControl>
